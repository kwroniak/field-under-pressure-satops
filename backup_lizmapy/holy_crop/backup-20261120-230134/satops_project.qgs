  &lt;table class="hc-source" style="display:none">&lt;tbody>&#xd;
[% aggregate(&#xd;
      layer := 'field_calendar_demo',&#xd;
      aggregate := 'concatenate',&#xd;
      expression := concat(&#xd;
          '&lt;tr>&lt;td>', format_date("observation_date", 'yyyy-MM-dd'),&#xd;
