          '&lt;/td>&lt;td>', coalesce(to_string("precipitation_mm"), ''),&#xd;
          '&lt;/td>&lt;/tr>'&#xd;
      ),&#xd;
      filter := "field_id" = attribute(@parent, 'id'),&#xd;
      concatenator := '',&#xd;
      order_by := "observation_date"&#xd;
  ) %]&#xd;
  &lt;/tbody>&lt;/table>&#xd;
