/* Project stylesheet: applied before JavaScript starts. */
html, body {margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#111727}
#header #logo, #header #title {display:none}
#header {background:#111727;height:51px;min-height:0;border:0}
#lizmap-project-warnings {display:none}
#loading {background:#121B2A;color:#E6ECF5;border:0;background-image:none}
.ui-dialog.liz-dialog-wait {background:#121B2A;color:#E6ECF5;border:1px solid #303B4B;border-radius:5px;box-shadow:none}
.liz-dialog-wait .ui-dialog-titlebar {background:#121B2A;color:#E6ECF5;border:0}
#loading img {visibility:hidden}
