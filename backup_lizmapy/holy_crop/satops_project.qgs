      <mapTip enabled="1">&lt;div class="hc-field-card">
  &lt;div class="hc-heading">&lt;span>MONITORING POLA&lt;/span>&lt;span class="hc-badge">[% CASE WHEN get_feature('field_profile', 'field_id', "id") IS NULL THEN 'POZA ANALIZĄ (&amp;lt; 3 ha)' ELSE 'STAN OD ' || format_date(attribute(get_feature('field_profile', 'field_id', "id"), 'as_of'), 'dd.MM.yyyy') END %]&lt;/span>&lt;/div>
  &lt;h2>Pole &lt;span class="hc-field-id">[% "id" %]&lt;/span> ([% format_number(area(transform($geometry, 'EPSG:3857', 'EPSG:2180')) / 10000, 2) %] ha)&lt;/h2>
  &lt;p>Ocena warunków nawożenia i nawadniania: pogoda, gleba, uprawa&lt;/p>
  &lt;table class="hc-source" style="display:none">&lt;tbody>
[% aggregate(
      layer := 'field_calendar',
      aggregate := 'concatenate',
      expression := concat(
          '&lt;tr>&lt;td>', format_date("day", 'yyyy-MM-dd'),
          '&lt;/td>&lt;td>', coalesce(to_string("ndvi"), ''),
          '&lt;/td>&lt;td>', coalesce(to_string("ndmi"), ''),
          '&lt;/td>&lt;td>', coalesce(to_string(attribute(get_feature('field_profile', 'field_id', "field_id"), 'ph')), ''),
          '&lt;/td>&lt;td>', coalesce(to_string("temp_mean_c"), ''),
          '&lt;/td>&lt;td>', coalesce(to_string("precip_24h_mm"), ''),
          '&lt;/td>&lt;td>', "fertilizer",
          '&lt;/td>&lt;td>', "status",
          '&lt;/td>&lt;td>', replace(coalesce("fert_reasons", ''), '&lt;', '&amp;lt;'),
          '&lt;/td>&lt;td>', coalesce("irrigation_risk", ''),
          '&lt;/td>&lt;td>', replace(coalesce("irrigation_reasons", ''), '&lt;', '&amp;lt;'),
          '&lt;/td>&lt;/tr>'
      ),
      filter := "field_id" = attribute(@parent, 'id'),
      concatenator := '',
      order_by := concat(format_date("day", 'yyyy-MM-dd'), "fertilizer")
  ) %]
  &lt;/tbody>&lt;/table>
  &lt;div class="hc-days">&lt;/div>
&lt;/div>
&lt;div class="hc-context">
  &lt;label>Uprawa
    &lt;select aria-label="Uprawa" disabled>&lt;option>[% coalesce(attribute(get_feature('field_profile', 'field_id', "id"), 'crop'), "crop_type", '—') %]&lt;/option>&lt;/select>
  &lt;/label>
  &lt;label>Nawóz
    &lt;select class="fc-fertilizer" aria-label="Nawóz">
      &lt;option value="saletra_amonowa">Saletra amonowa (34% N)&lt;/option>
      &lt;option value="mocznik_inhibitor">Mocznik z inhibitorem (46% N)&lt;/option>
      &lt;option value="rsm_32">RSM 32&lt;/option>
      &lt;option value="saletrosan_26">Saletrosan 26 (26% N + 13% S)&lt;/option>
    &lt;/select>
  &lt;/label>
  &lt;div class="hc-tags">
    &lt;span class="hc-tag">Tekstura: [% coalesce(attribute(get_feature('field_profile', 'field_id', "id"), 'texture'), '—') %]&lt;/span>
    &lt;span class="hc-tag">pH: [% coalesce(format_number(attribute(get_feature('field_profile', 'field_id', "id"), 'ph'), 1), '—') %]&lt;/span>
    &lt;span class="hc-tag">Klasa: [% coalesce(attribute(get_feature('field_profile', 'field_id', "id"), 'klasa_bonitacyjna'), '—') %]&lt;/span>
    &lt;span class="hc-tag">Przepuszczalność: [% coalesce(attribute(get_feature('field_profile', 'field_id', "id"), 'permeability'), '—') %]&lt;/span>
  &lt;/div>
&lt;/div>
</mapTip>
